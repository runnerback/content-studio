# wechat-proxy 环境变量模板
# 首次部署时在 ECS 上复制为 .env 并填好；.env 不要提交 git、也不随 rsync 覆盖。

# 监听端口（nginx 反代到这里，保持 127.0.0.1 只允许本机 nginx 访问）
PORT=3000
HOST=127.0.0.1

# 代理访问口令（强烈建议设置）。设置后，插件里的代理地址必须带 ?token=<这里的值>，
# 否则返回 401。留空则不校验（仅靠域名白名单，任何人知道地址都能用你的 ECS 转发）。
# 生成一个随机口令：openssl rand -hex 16
PROXY_TOKEN=<你的PROXY_TOKEN>

# ────────────────────────────────────────────────────────────────
# 插件端「API 代理地址」（复制整行填进 Obsidian 插件设置 → 高级 → API 代理地址）：
# https://<你的代理域名>/proxy?token=<你的PROXY_TOKEN>
# 说明：域名=ECS 上 nginx 反代域名；路径 /proxy=app.js 转发路由；token 需与上面 PROXY_TOKEN 一致。
# 前置条件：微信公众平台 IP 白名单已加入 ECS 公网 IP <你的服务器公网IP>。
# ────────────────────────────────────────────────────────────────
